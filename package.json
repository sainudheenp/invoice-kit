{
  "name": "invoicekitz",
  "private": true,
  "description": "Client-side invoice, receipt, and quotation generator",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sainudheenp/invoice-kit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run fonts:check && npm run deps:ensure && npm run taepdf:ensure && tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --ignore-pattern \"vendor/**\"",
    "preview": "vite preview",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "fonts:check": "node scripts/sync-fonts.mjs --check",
    "taepdf:ensure": "node scripts/ensure-taepdf.mjs",
    "predev": "npm run deps:ensure && npm run taepdf:ensure",
    "deps:ensure": "node scripts/ensure-deps.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "taepdf": "file:./vendor/taepdf"
  },
  "devDependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  }
}
