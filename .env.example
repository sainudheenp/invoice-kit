# ------------------------------------------------------------------
# IN DRIVE TOURS — environment configuration
# Copy to .env.local and fill in the real business details.
# ------------------------------------------------------------------

# Business WhatsApp number in international format WITHOUT "+" or spaces.
# Example for an Indian number: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Public display phone (shown in header/footer). Include + and spaces.
NEXT_PUBLIC_PHONE_DISPLAY=+91 99999 99999

# tel: link target (digits only, international format)
NEXT_PUBLIC_PHONE_NUMBER=919999999999

# Business email
NEXT_PUBLIC_EMAIL=hello@indrivetours.in

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.indrivetours.in

# Google Analytics Measurement ID (optional, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID (optional, e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
